#!/usr/bin/env zsh
#
# setup - the single entry point for this machine.
#
# This script is the documentation. Anything you would be tempted to write in a
# README is a missing step here: add the step instead of describing it.
#
#   ./setup            interactive: report, propose, ask
#   ./setup --check     read-only, exits non-zero on drift
#   ./setup --yes       non-interactive, takes the defaults (new machine, CI)
#   ./setup <step>...   run only those steps, e.g. ./setup home claude
#   ./setup --help      the list of steps, generated from the registry below
#
# Dependencies: zsh, shipped with macOS. Homebrew is installed by the brew step,
# everything else comes from the Brewfile.

emulate -L zsh
setopt no_unset pipe_fail
zmodload zsh/datetime

SCRIPT=${0:A}        # captured here: inside a zsh function, $0 is the function name
REPO=${SCRIPT:h}
STAMP=$HOME/.setup-last-check
NOTIFY=$HOME/.setup-notify   # the weekly check drops its summary here, Setup.app posts it

MODE=apply          # apply | check
ASSUME_YES=0
typeset -i DRIFT=0  # number of things that need doing

# --- the step registry ---------------------------------------------------
# One entry per step, in run order. --help prints this, so the help can never
# go stale. Each step is implemented by step_<name> below.

STEPS=(
  xcode    'Xcode Command Line Tools'
  brew     'Homebrew itself'
  packages 'Packages, casks and App Store apps from the Brewfile'
  xcodes   'Xcode versions pinned next to the App Store one, through xcodes'
  hooks    'This repo own git hooks, so gitleaks runs before each commit'
  home     'Dotfiles, symlinked from home/ into ~'
  prezto   'The zsh framework .zshrc sources and .zpreztorc configures'
  claude   'Claude Code config, symlinked from claude/ into ~/.claude'
  macos    'macOS preferences from preferences/ and macos.sh'
  ssh      'This machine own SSH key'
  secrets  'Secrets in the login keychain, from secrets.tsv'
  dev      'Repos under ~/dev, and what exists only on this machine'
  backup   'Fonts, Claude projects and .env files, copied to iCloud Drive'
  agent    'The weekly check, as a LaunchAgent'
)

# --- output helpers ------------------------------------------------------

title() { print -r -- $'\n'"$1" }
ok()    { print -r -- "  ok    $1" }
todo()  { print -r -- "  TODO  $1"; (( DRIFT++ )) }
note()  { print -r -- "  note  $1" }
fail()  { print -ru2 -- "  ERROR $1"; (( DRIFT++ )) }

# Ask a yes/no question. Never asks in check mode, never asks with --yes.
confirm() {
  [[ $MODE == check ]] && return 1
  (( ASSUME_YES )) && return 0
  local answer
  read -q "answer?  $1 [y/N] " || true
  print
  [[ $answer == y ]]
}

have() { (( $+commands[$1] )) }

# Ensure dest is a symlink to src. The single place that touches the user home,
# so a real file is never destroyed: it is moved aside first.
ensure_link() {
  local src=$1 dest=$2 pretty=${2/#$HOME/\~}
  if [[ ! -e $src && ! -L $src ]]; then
    note "$pretty skipped, ${src/#$REPO\//} is not in the repo yet"
    return 1
  fi
  if [[ -L $dest && ${dest:A} == ${src:A} ]]; then
    ok "$pretty"
    return 0
  fi
  if [[ $MODE == check ]]; then
    if [[ -L $dest ]]; then
      todo "$pretty points at ${dest:A/#$HOME/\~} instead of the repo"
    elif [[ -e $dest ]]; then
      # Newer matters: an application that rewrites its config by replacing the
      # file destroys the link, and then the real file holds changes the repo
      # does not. Applying would move it aside and relink, which is recoverable
      # but is still a revert, so it is named here rather than discovered after.
      if [[ $dest -nt $src ]]; then
        todo "$pretty is a real file, newer than the repo copy: it has changes to keep"
      else
        todo "$pretty is a real file, not a link to the repo"
      fi
    else
      todo "$pretty is missing"
    fi
    return 1
  fi
  if [[ -e $dest || -L $dest ]]; then
    local backup=$dest.before-setup-$(strftime '%Y%m%d%H%M%S' $EPOCHSECONDS)
    mv -- "$dest" "$backup" || { fail "could not move $pretty aside"; return 1 }
    note "moved the previous $pretty to ${backup:t}"
  fi
  mkdir -p -- "${dest:h}"
  ln -s -- "$src" "$dest" && ok "$pretty linked"
}

# --- steps ---------------------------------------------------------------

step_xcode() {
  if /usr/bin/xcode-select -p >/dev/null 2>&1; then
    ok "installed at $(/usr/bin/xcode-select -p)"
  elif [[ $MODE == check ]]; then
    todo "Xcode Command Line Tools are missing"
  else
    todo "Xcode Command Line Tools are missing"
    note "running xcode-select --install, finish it in the window that opens"
    /usr/bin/xcode-select --install 2>/dev/null || true
  fi
}

step_brew() {
  if have brew; then
    ok "$(brew --version | head -1)"
    return
  fi
  # Apple Silicon puts it here; pick it up if it exists but is not on PATH yet.
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    ok "found at /opt/homebrew, not on PATH yet (the home step fixes that)"
    return
  fi
  todo "Homebrew is not installed"
  [[ $MODE == check ]] && return
  note 'install command: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
  if confirm "Download and run the official Homebrew installer?"; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
}

step_packages() {
  have brew || { note "skipped, Homebrew first"; return }
  local file=$REPO/Brewfile
  if [[ ! -f $file ]]; then
    note "skipped, Brewfile is not in the repo yet"
    return
  fi

  # Set differences, both ways. Formulae, casks and taps are separate
  # namespaces: in one bucket every declared tap looks like a missing package.
  local -a declared missing extra
  local -a d_formula d_cask d_tap i_formula i_cask i_tap
  d_formula=("${(@f)$(brew bundle list --formula --file="$file" 2>/dev/null)}")
  d_cask=("${(@f)$(brew bundle list --cask --file="$file" 2>/dev/null)}")
  d_tap=("${(@f)$(brew bundle list --tap --file="$file" 2>/dev/null)}")
  i_formula=("${(@f)$(brew list --formula --full-name 2>/dev/null)}")
  i_cask=("${(@f)$(brew list --cask 2>/dev/null)}")
  i_tap=("${(@f)$(brew tap 2>/dev/null)}")
  declared=($d_formula $d_cask $d_tap)

  local pkg
  missing=()
  for pkg in $d_formula; do
    [[ -n $pkg ]] || continue
    # A tapped formula is declared as tap/name, listed by its short name too.
    (( ${i_formula[(Ie)$pkg]} )) && continue
    (( ${i_formula[(Ie)${pkg:t}]} )) && continue
    missing+=("$pkg")
  done
  for pkg in $d_cask; do
    [[ -n $pkg ]] && (( ! ${i_cask[(Ie)$pkg]} )) && missing+=("$pkg (cask)")
  done
  for pkg in $d_tap; do
    [[ -n $pkg ]] && (( ! ${i_tap[(Ie)$pkg]} )) && missing+=("$pkg (tap)")
  done
  # App Store apps, compared by name: `mas list` prints "id Name (version)".
  local -a d_mas i_mas
  if have mas; then
    d_mas=("${(@f)$(brew bundle list --mas --file="$file" 2>/dev/null)}")
    i_mas=("${(@f)$(mas list 2>/dev/null | sed -E 's/^ *[0-9]+ +//; s/ +\([^)]*\) *$//')}")
    for pkg in $d_mas; do
      [[ -n $pkg ]] && (( ! ${i_mas[(Ie)$pkg]} )) && missing+=("$pkg (App Store)")
    done
  fi
  if (( $#missing )); then
    todo "$#missing declared but not installed: ${(j:, :)missing}"
    # --no-upgrade on purpose: re-running setup installs what is missing and
    # never silently upgrades the rest. Upgrading is its own deliberate act.
    [[ $MODE == check ]] || brew bundle install --no-upgrade --file="$file"
  else
    ok "everything in the Brewfile is installed"
  fi

  # The other direction: installed on purpose but never written down. This is
  # the "I ran brew install by hand three weeks ago" case.
  extra=()
  for pkg in "${(@f)$(brew leaves --installed-on-request 2>/dev/null)}"; do
    [[ -n $pkg ]] || continue
    (( ${declared[(Ie)$pkg]} )) && continue
    (( ${declared[(Ie)${pkg:t}]} )) && continue
    extra+=("$pkg")
  done
  for pkg in "${(@f)$(brew list --cask 2>/dev/null)}"; do
    [[ -n $pkg ]] || continue
    (( ${declared[(Ie)$pkg]} )) && continue
    extra+=("$pkg (cask)")
  done
  for pkg in $i_mas; do
    [[ -n $pkg ]] && (( ! ${d_mas[(Ie)$pkg]} )) && extra+=("$pkg (App Store)")
  done
  if (( $#extra )); then
    todo "$#extra installed on purpose but absent from the Brewfile:"
    print -r -- "       ${(j:, :)extra}"
    note "add them with: brew bundle add <name> --file=Brewfile"
  else
    ok "nothing installed outside the Brewfile"
  fi

  # Never --greedy: it reinstalls the applications that update themselves and
  # overrides a version picked on purpose.
  local -a outdated
  outdated=(${(f)"$(brew outdated --quiet 2>/dev/null)"})
  outdated=(${outdated:#})
  if (( ! $#outdated )); then
    ok "everything is up to date"
  elif [[ $MODE == check ]]; then
    local plural=s; (( $#outdated == 1 )) && plural=
    todo "$#outdated package$plural behind"
    print -r -- "       ${(j:, :)outdated}"
  else
    note "upgrading $#outdated: ${(j:, :)outdated}"
    brew upgrade && ok "up to date" || fail "brew upgrade did not finish"
  fi

  # Apps with no cask, declared in apps-manual.md as "- Name: url". Matched by
  # prefix, because some ship their version in the application name.
  local manual=$REPO/apps-manual.md
  if [[ -f $manual ]]; then
    local -a absent urls found
    local line mname murl
    while IFS= read -r line; do
      [[ $line == -\ *:\ http* ]] || continue
      mname=${${line#- }%%:*}
      murl=${line#*: }
      found=(/Applications/$mname*.app(N) $HOME/Applications/$mname*.app(N))
      (( $#found )) && continue
      absent+=("$mname"); urls+=("$murl")
    done < "$manual"
    if (( $#absent )); then
      local aplural=s; (( $#absent == 1 )) && aplural=
      todo "$#absent app$aplural to reinstall by hand: ${(j:, :)absent}"
      if [[ $MODE != check ]] && confirm "Open their download pages?"; then
        open -- $urls
      fi
    fi
  fi

  # Apps installed from a website that a cask could take over. A note and not a
  # TODO on purpose: it is a standing opportunity, not something broken, and
  # turning it into drift would nag about twenty apps forever.
  if [[ -x $REPO/bin/apps ]]; then
    local summary
    summary=$("$REPO/bin/apps" 2>/dev/null | grep 'installed by hand' | head -1)
    [[ -n $summary ]] && note "${summary%.} (bin/apps)"
  fi
}

step_xcodes() {
  have xcodes || { note "skipped, xcodes comes with the packages step"; return }
  local v
  for v in 26.6; do
    if xcodes installed "$v" >/dev/null 2>&1; then
      ok "Xcode $v"
    # Several GB and an Apple ID prompt, so only with someone there to answer.
    elif [[ $MODE != check ]] && (( ! ASSUME_YES )) && [[ -t 0 ]] \
         && confirm "Xcode $v is missing, download it now?"; then
      xcodes install "$v" && ok "Xcode $v installed" || fail "xcodes could not install $v"
    else
      todo "Xcode $v is missing, run: xcodes install $v"
    fi
  done
}

step_hooks() {
  # core.hooksPath rather than .git/hooks: the hook is then versioned and a
  # fresh clone has it, instead of a file that exists only on this machine.
  local want=hooks
  local current
  current=$(git -C "$REPO" config --get core.hooksPath 2>/dev/null)
  if [[ $current == $want ]]; then
    ok "core.hooksPath = $want"
  elif [[ $MODE == check ]]; then
    todo "core.hooksPath is ${current:-unset}, should be $want"
  else
    git -C "$REPO" config core.hooksPath "$want" && ok "core.hooksPath set to $want" \
      || fail "could not set core.hooksPath"
  fi
  have gitleaks && ok "gitleaks $(gitleaks version 2>/dev/null)" \
    || todo "gitleaks is missing, the hook will refuse every commit"
}

step_home() {
  local dir=$REPO/home
  if [[ ! -d $dir ]]; then
    note "skipped, home/ does not exist yet (dotfiles still live in iCloud .home)"
    return
  fi
  # Files, never directories. Linking home/.config would replace ~/.config
  # itself with a link into the repo, and with it the gh, rclone, beets and
  # git-cliff configs that live there and are not versioned here. Linking
  # leaves is what lets one file be versioned inside a directory other tools
  # also write to, and it is the same reason ~/.ssh keeps only its config
  # linked.
  local file rel
  for file in ${(f)"$(find "$dir" -type f -not -name .DS_Store 2>/dev/null | sort)"}; do
    rel=${file#$dir/}
    # .ssh belongs to step_ssh, which owns it alongside the key.
    [[ $rel == .ssh/* ]] && continue
    ensure_link "$file" "$HOME/$rel"
  done
}

step_prezto() {
  # What .zshrc sources and .zpreztorc configures. Without it the shell still
  # starts, silently, with no pure prompt, no syntax highlighting and no
  # autosuggestions. https and not ssh: on a new machine the key is not on
  # GitHub yet.
  local dir=$HOME/.zprezto
  if [[ -s $dir/init.zsh ]]; then
    ok "~/.zprezto"
  elif [[ $MODE == check ]]; then
    todo "~/.zprezto is missing, the prompt and the highlighting would be silently absent"
  else
    git clone --recursive https://github.com/sorin-ionescu/prezto.git "$dir" \
      && ok "~/.zprezto cloned" || fail "could not clone prezto"
  fi
}

step_claude() {
  # One link per entry, never the skills/ directory itself: it also holds
  # synced/, which Claude manages, and skills that are not ours.
  ensure_link "$REPO/claude/CLAUDE.md"              "$HOME/.claude/CLAUDE.md"
  ensure_link "$REPO/claude/settings.json"          "$HOME/.claude/settings.json"
  ensure_link "$REPO/claude/skills/grill-me"        "$HOME/.claude/skills/grill-me"
  ensure_link "$REPO/claude/commands/unpushed.md"   "$HOME/.claude/commands/unpushed.md"
}

step_macos() {
  local dir=$REPO/preferences
  if [[ -d $dir ]]; then
    # The versioned ones only, which is what .gitignore says: bin/prefs --all
    # drops every domain this machine exposes in here to be read, and those are
    # not ours to restore.
    #
    # Of those, only domains still empty, which is the new machine case since a
    # cask installs without launching. On a machine in use the live settings
    # win, so a GUI tweak is never reverted. Record one with bin/prefs.
    local -a wanted=(${(f)"$("$REPO/bin/prefs" --versioned 2>/dev/null)"})
    wanted=(${wanted:#})
    local d count=0 live
    local -a restore
    for d in $wanted; do
      (( count++ ))
      # No pipe into grep -q here: it exits on the first match, `defaults`
      # takes SIGPIPE, and pipe_fail then turns a domain that does have
      # settings into one reported as missing, non deterministically, since it
      # depends on which side finishes first.
      live=$(defaults export "$d" - 2>/dev/null)
      [[ $live == *'<key>'* ]] && continue
      restore+=("$d")
    done
    local -a present=("$dir"/*.plist(N))
    if (( ! count )); then
      note "preferences/ versions no domain yet"
    elif (( ! $#restore )); then
      ok "$count app preferences already set"
    elif [[ $MODE == check ]]; then
      todo "$#restore app preferences to restore: ${(j:, :)restore}"
    else
      for d in $restore; do
        defaults import "$d" "$dir/$d.plist" && ok "$d imported"
      done
    fi
    (( $#present > count )) && note "$(( $#present - count )) more generated here, not versioned"
  else
    note "skipped, preferences/ does not exist yet"
  fi

  # The other direction: a setting changed in a GUI has to come back into the
  # repository, or preferences/ becomes a snapshot of a machine that no longer
  # exists. bin/prefs --check names what drifted.
  if [[ -x $REPO/bin/prefs ]]; then
    local changed
    changed=$("$REPO/bin/prefs" --check 2>/dev/null)
    if [[ -n $changed ]]; then
      local -a names=(${(f)changed})
      local word=preferences
      (( $#names == 1 )) && word=preference
      if [[ $MODE == check ]]; then
        todo "$#names app $word changed since saved: ${(j:, :)names}"
      else
        "$REPO/bin/prefs" >/dev/null 2>&1
        note "$#names app $word re-saved, review the diff and commit"
      fi
    fi
  fi

  if [[ -x $REPO/macos.sh ]]; then
    if [[ $MODE == check ]]; then
      # No parsing: macos.sh is sourced with `defaults` shadowed by a function
      # that compares instead of writing, so the file stays the only source of
      # truth and a $HOME inside a value expands as it would on a real run.
      # killall is shadowed too, or checking would restart the Dock.
      local -a differing
      local -i checked=0
      defaults() {
        [[ ${1:-} == write ]] || return 0
        (( checked++ ))
        local domain=$2 key=$3 type=${4:-} want=${5:-} got
        [[ $type == -bool ]] && { [[ $want == true ]] && want=1 || want=0 }
        got=$(command defaults read "$domain" "$key" 2>/dev/null)
        [[ $got == $want ]] || differing+=("$key")
      }
      killall() { return 0 }
      source "$REPO/macos.sh" >/dev/null 2>&1
      unfunction defaults killall
      if (( ! checked )); then
        note "macos.sh declares no setting"
      elif (( $#differing )); then
        todo "$#differing of $checked macOS settings differ: ${(j:, :)differing}"
      else
        ok "$checked macOS settings as declared"
      fi
    else
      "$REPO/macos.sh" && ok "macos.sh applied"
    fi
  else
    note "skipped, macos.sh does not exist yet"
  fi
}

step_ssh() {
  # ssh/config is linked here and not by step_home, because home/ links its
  # top-level entries: a home/.ssh directory would turn ~/.ssh itself into a
  # link to the repo, and the private keys with it.
  ensure_link "$REPO/home/.ssh/config" "$HOME/.ssh/config"

  # One key per machine, never copied, never overwritten.
  local key=$HOME/.ssh/id_ed25519
  if [[ -f $key.pub ]]; then
    ok "$(ssh-keygen -lf "$key.pub" 2>/dev/null)"

    # Verified, not a standing reminder: a note printed on every run is one
    # nobody reads any more. Only the auth key can be read back, since listing
    # signing keys needs the admin:ssh_signing_key scope the token does not
    # carry, so the signing side is checked locally.
    local body=${$(<$key.pub)[2]}
    local remote
    if have gh && remote=$(gh api /user/keys --jq '.[].key' 2>/dev/null); then
      # grep -c, not -q: see the note in step_macos about SIGPIPE.
      if (( $(print -r -- "$remote" | awk '{print $2}' | grep -cxF -- "$body") )); then
        ok "registered on GitHub as an auth key"
      else
        todo "not on GitHub as an auth key: https://github.com/settings/keys"
      fi
    else
      note "GitHub unreachable, registration unchecked"
    fi
    if [[ $(git config --global gpg.format) == ssh \
       && -n $(git config --global user.signingkey) ]]; then
      ok "git signs with it"
    else
      todo "git is not set to sign with this key"
    fi
    return
  fi
  todo "this machine has no ed25519 key"
  [[ $MODE == check ]] && return
  # Precomputed: inside double quotes the backslash of \~ would be printed.
  local pretty=${key/#$HOME/\~}
  if confirm "Generate $pretty for $(hostname -s)?"; then
    mkdir -p -m 700 -- "$HOME/.ssh"
    # Interactive: ssh-keygen asks for a passphrase, which is the point, and
    # ssh/config stores it in the keychain so it is asked once ever. Without a
    # terminal (CI) there is nobody to ask, and the key is a throwaway anyway.
    local -a pass_args=()
    [[ -t 0 ]] || pass_args=(-N '')
    ssh-keygen -t ed25519 -C "$(whoami)@$(hostname -s)" -f "$key" $pass_args \
      && ok "created, public key:" && print -r -- "       $(<$key.pub)"
  fi
}

step_secrets() {
  local file=$REPO/secrets.tsv
  if [[ ! -f $file ]]; then
    note "skipped, secrets.tsv is not in the repo yet"
    return
  fi

  # Rotation walk only when the step is asked for by name. In a full run the
  # step only fills what is missing, so a machine that is already set up has
  # nothing to answer.
  local rotate=0
  [[ $#STEP_ARGS == 1 && ${STEP_ARGS[1]:-} == secrets ]] && rotate=1

  local -a names wheres recoveries
  local name where what recovery
  while IFS=$'\t' read -r name where what recovery; do
    [[ -z $name || $name == \#* ]] && continue
    names+=("$name"); wheres+=("$where"); recoveries+=("$recovery")
  done < "$file"

  local -i set_count=0 missing=0
  local -a missing_names
  for name in "${names[@]}"; do
    if security find-generic-password -a "$USER" -s "$name" >/dev/null 2>&1; then
      (( set_count++ ))
    else
      (( missing++ )); missing_names+=("$name")
    fi
  done

  print -r -- "  secrets: $set_count/$#names set"
  if (( missing )); then
    todo "missing: ${(j:, :)missing_names}"
  fi
  [[ $MODE == check ]] && return
  (( missing == 0 )) && (( ! rotate )) && { ok "nothing to do"; return }

  local i=0 value again
  for name in "${names[@]}"; do
    (( i++ ))
    where=${wheres[$i]}
    local critical=0
    [[ ${recoveries[$i]} == critical ]] && critical=1
    local is_set=0
    security find-generic-password -a "$USER" -s "$name" >/dev/null 2>&1 && is_set=1

    (( is_set && ! rotate )) && continue

    print
    print -r -- "$name  $( (( is_set )) && print -n 'set' || print -n 'not set')"
    [[ -n $where ]] && print -r -- "  $( (( is_set )) && print -n 'rotate' || print -n 'create') at $where"
    if (( critical )); then
      print -r -- "  CRITICAL: this one cannot be recreated, it decrypts data that exists nowhere else."
      if (( is_set )); then
        print -r -- "  Replacing it here does not re-encrypt anything. Only do this as part of a"
        print -r -- "  real rotation, see docs/05-rotation.md in MoOx/certificates."
      fi
    fi

    if (( is_set )); then
      # A value already exists, so pressing enter keeps it.
      IFS= read -rs "value?  new value (enter to keep): " || true
      print
      [[ -z $value ]] && { print -r -- "  kept"; continue }
    else
      # Nothing stored, so leaving is explicit: only "skip" moves on.
      while :; do
        IFS= read -rs 'value?  value (or "skip"): ' || true
        print
        [[ $value == skip ]] && break
        [[ -n $value ]] && break
        print -r -- '  type the value, or "skip" to leave it unset'
      done
      [[ $value == skip ]] && { print -r -- "  skipped, still unset"; continue }
    fi

    # A critical secret is typed twice: a typo would store fine, look fine, and
    # only surface much later as a failed decryption.
    if (( critical )); then
      IFS= read -rs "again?  type it again to confirm: " || true
      print
      if [[ $value != $again ]]; then
        fail "the two entries differ, $name left unchanged"
        value=''; again=''
        continue
      fi
      again=''
    fi

    if security add-generic-password -a "$USER" -s "$name" -U -w "$value" 2>/dev/null; then
      print -r -- "  stored, ${#value} characters"
    else
      fail "could not store $name in the keychain"
    fi
    value=''
  done
}

step_backup() {
  if [[ ! -x $REPO/bin/backup ]]; then
    note "skipped, bin/backup is missing"
    return
  fi
  if [[ ! -f $REPO/backup.pub ]]; then
    todo "no key pair yet, run: ./bin/backup init"
    return
  fi

  local dir=$("$REPO/bin/backup" path)
  local pretty=${dir/#$HOME/\~}

  # No fonts here but fonts in the backup: this is a new machine.
  if [[ -d $dir/Library/Fonts && ! -d $HOME/Library/Fonts ]]; then
    todo "$pretty holds a backup to paste"
    [[ $MODE == check ]] && return
    confirm "Paste it now?" && "$REPO/bin/backup" paste
    return
  fi

  if [[ $MODE == check ]]; then
    [[ -d $dir ]] && ok "$pretty" || todo "nothing copied to $pretty yet"
  else
    "$REPO/bin/backup" copy
  fi
}

step_agent() {
  local label=io.moox.setup.check
  local src=$REPO/launchd/$label.plist
  local dest=$HOME/Library/LaunchAgents/$label.plist

  if [[ ! -f $src ]]; then
    note "skipped, $src is missing"
    return
  fi

  # Rendered, not linked: launchd expands neither ~ nor environment variables
  # in a path, so the real ones have to be written in.
  local rendered
  rendered=$(sed -e "s|__REPO__|$REPO|g" -e "s|__HOME__|$HOME|g" "$src")

  local pretty=${dest/#$HOME/\~}
  # The right side is quoted: unquoted it would be a glob pattern, and the `?`
  # of `<?xml` matches any character, so a plist that differs there would pass
  # for identical.
  if [[ -f $dest ]] && [[ $(<$dest) == "$rendered" ]]; then
    ok "$pretty"
  elif [[ $MODE == check ]]; then
    todo "$pretty is missing or out of date"
  else
    mkdir -p -- "${dest:h}"
    print -r -- "$rendered" >| "$dest" && ok "written"
    # bootout first so a changed plist is actually reloaded; it fails
    # harmlessly when nothing was loaded.
    launchctl bootout "gui/$UID/$label" 2>/dev/null
    launchctl bootstrap "gui/$UID" "$dest" 2>/dev/null && ok "loaded" \
      || todo "could not load it, try: launchctl bootstrap gui/$UID $dest"
  fi

  if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
    ok "loaded in launchd"
  else
    todo "not loaded in launchd"
  fi

  # Clicking a notification activates the app that posted it, which is the only
  # click target a notification has. The rendered source stays in the bundle
  # because a compiled .scpt cannot be diffed.
  local app=$HOME/Applications/Setup.app
  local app_src=$REPO/launchd/Setup.applescript
  local app_pretty=${app/#$HOME/\~}
  local app_stamp=$app/Contents/Resources/source.applescript
  if [[ ! -f $app_src ]]; then
    note "skipped, ${app_src/#$REPO\//} is missing"
  else
    local app_rendered
    app_rendered=$(sed -e "s|__FLAG__|$NOTIFY|g" \
                       -e "s|__COMMAND__|$REPO/bin/setup.command|g" "$app_src")
    if [[ -f $app_stamp ]] && [[ $(<$app_stamp) == "$app_rendered" ]]; then
      ok "$app_pretty"
    elif [[ $MODE == check ]]; then
      todo "$app_pretty is missing or out of date"
    else
      local tmp=${TMPDIR:-/tmp}/setup-applet.$$
      mkdir -p -- "$tmp" "${app:h}"
      print -r -- "$app_rendered" >| "$tmp/Setup.applescript"
      rm -rf -- "$app"
      if osacompile -o "$app" "$tmp/Setup.applescript" 2>/dev/null; then
        print -r -- "$app_rendered" >| "$app_stamp"
        # osacompile leaves no CFBundleIdentifier, and a notification with no
        # identity never shows. Re-signed last: writing into the bundle
        # invalidates osacompile's signature.
        plutil -replace CFBundleIdentifier -string io.moox.setup "$app/Contents/Info.plist" >/dev/null 2>&1
        codesign -f -s - "$app" >/dev/null 2>&1
        ok "$app_pretty built"
      else
        fail "could not compile $app_pretty"
      fi
      rm -rf -- "$tmp"
    fi
  fi

  # What the app opens. Without it the notification still shows, the click just
  # does nothing.
  [[ -x $REPO/bin/setup.command ]] || todo "bin/setup.command is missing or not executable"
}

step_dev() {
  if [[ ! -x $REPO/bin/unpushed ]]; then
    note "skipped, bin/unpushed is missing"
    return
  fi
  local snapshot=''
  [[ -x $REPO/bin/dev-snapshot ]] && snapshot=$("$REPO/bin/dev-snapshot" --path)

  # A new machine has no ~/dev. The snapshot in iCloud Drive is what brings it
  # back, since every repository there has a remote.
  if [[ ! -d $HOME/dev ]]; then
    if [[ -n $snapshot && -f $snapshot ]]; then
      todo "~/dev is missing, $(grep -c . -- "$snapshot") repos in the snapshot"
      [[ $MODE == check ]] && return
      confirm "Clone them now?" && "$REPO/bin/dev-snapshot" --restore
    else
      note "no ~/dev yet"
    fi
    return
  fi
  # unpushed prints its own table and summary. Its output is captured so the
  # todo line can carry the numbers: the weekly notification is built from the
  # TODO lines, and a count that visibly drops is what makes the triage feel
  # worth doing.
  local out
  out=$("$REPO/bin/unpushed" 2>&1)
  local rc=$?
  print -r -- "$out"

  [[ $MODE == check ]] || [[ -z $snapshot ]] || "$REPO/bin/dev-snapshot" >/dev/null

  (( rc == 0 )) && return
  local summary
  summary=$(print -r -- "$out" | grep -m1 'repos:')
  todo "${summary:-work exists only on this machine}"

  # And offer the triage here, because a second command to remember is a second
  # command to forget. --clean asks a question per repository, so it is only
  # offered when there is someone to answer: not in check mode, not under
  # --yes, not without a terminal.
  [[ $MODE == check ]] && return
  (( ASSUME_YES )) && return
  [[ -t 0 ]] || return
  confirm "Go through them now?" && "$REPO/bin/unpushed" --clean
}

# --- driver --------------------------------------------------------------

usage() {
  sed -n '3,16p' "$SCRIPT" | sed 's/^#\{1,\} \{0,1\}//'
  print "Steps, in run order:"
  local i
  for (( i = 1; i <= $#STEPS; i += 2 )); do
    printf '  %-9s %s\n' "$STEPS[i]" "$STEPS[i+1]"
  done
}

run_step() {
  local name=$1 i
  for (( i = 1; i <= $#STEPS; i += 2 )); do
    if [[ $STEPS[i] == $name ]]; then
      title "$name: $STEPS[i+1]"
      step_$name
      return 0
    fi
  done
  print -ru2 -- "setup: unknown step: $name"
  print -ru2 -- "setup: known steps: $(for (( i = 1; i <= $#STEPS; i += 2 )); do print -n "$STEPS[i] "; done)"
  return 2
}

# A list, not one name: `setup hooks macos` used to keep only the last one and
# run it without a word about the others.
STEP_ARGS=()
for arg in "$@"; do
  case $arg in
    --check)     MODE=check ;;
    --yes|-y)    ASSUME_YES=1 ;;
    -h|--help)   usage; exit 0 ;;
    -*)          print -ru2 -- "setup: unknown option: $arg"; exit 2 ;;
    *)           STEP_ARGS+=("$arg") ;;
  esac
done

# Watching the watcher: say when the last check ran, so a silent agent shows up.
if [[ $MODE == apply && -f $STAMP ]]; then
  local -i age=$(( (EPOCHSECONDS - $(<$STAMP)) / 86400 ))
  if (( age > 14 )); then
    print -r -- "last check: $age days ago, the weekly agent may have stopped"
  else
    print -r -- "last check: $age days ago"
  fi
fi

if (( $#STEP_ARGS )); then
  for arg in $STEP_ARGS; do
    run_step "$arg" || exit $?
  done
else
  for (( i = 1; i <= $#STEPS; i += 2 )); do
    run_step "$STEPS[i]"
  done
fi

print
if (( DRIFT == 0 )); then
  print -r -- "Nothing to do."
  [[ $MODE == check ]] && print -n $EPOCHSECONDS >| $STAMP
  exit 0
fi

label="things need"
(( DRIFT == 1 )) && label="thing needs"

if [[ $MODE == check ]]; then
  print -n $EPOCHSECONDS >| $STAMP
  print -r -- "$DRIFT $label attention. Run ./setup."
  exit 1
fi
print -r -- "Still $DRIFT $label attention, see the TODO lines above."
exit 1
