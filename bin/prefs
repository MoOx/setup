#!/usr/bin/env zsh
# Save app preferences into preferences/, which setup restores on a new machine.
#
#   bin/prefs                 re-save what preferences/ already holds
#   bin/prefs <domain>...     add these domains
#
# A domain is a bundle identifier, e.g. com.knollsoft.Rectangle.

emulate -L zsh
set -uo pipefail

dir=${0:A:h:h}/preferences
mkdir -p -- "$dir"

# This repository is public and an export carries the whole domain, so two
# kinds of key are removed before it lands.
#
# A credential. The names are reported, never the values. iStat Menus keeps a
# License and a Device.Auth-Identifier, Sketch a BCLicense and a crashLogEmail,
# Yate a ServerAccessToken. Breadth is cheap here, since the answer is to strip
# a key the application writes again: the pattern once caught BetterDisplay's
# activationPriority and iTerm's AiMaxTokens, and losing those costs nothing.
cred_keys() {
  grep -oE '<key>[^<]*</key>' "$1" | sed 's/<[^>]*>//g' \
    | grep -iE 'licen|serial|token|secret|passw|email|apikey|credential|receipt|auth|signature' \
    | sort -u
}

# Noise. Recent file lists, window geometry and update checker state are not
# settings: they differ on every machine, they say which files were opened, and
# they are what makes an export look personal. VLC kept 21 media paths in
# recentlyPlayedMediaList alone.
noise_keys() {
  grep -oE '<key>[^<]*</key>' "$1" | sed 's/<[^>]*>//g' \
    | grep -iE 'recent|history|lastused|lastopen|^NSNav|^NSWindow Frame|^NSSplitView|^NSToolbar|^SU[A-Z]|updatechecker' \
    | sort -u
}

key_count() { grep -cF "<key>$2</key>" "$1" || true }

# Remove one key, at the top level or one dict below, which is as deep as a
# plutil keypath can be guessed. The removal is measured and not trusted:
# plutil -remove returns 0 for a keypath that does not exist, so
# Artists.ServerAccessToken once reported success on a dict that never held it.
strip_key() {
  local file=$1 key=$2 top before
  before=$(key_count "$file" "$key")
  (( before )) || return 1
  plutil -remove "$key" "$file" 2>/dev/null
  (( $(key_count "$file" "$key") < before )) && return 0
  for top in ${(f)"$(plutil -p "$file" | sed -n 's/^  "\([^"]*\)" => .*/\1/p')"}; do
    plutil -remove "$top.$key" "$file" 2>/dev/null
    (( $(key_count "$file" "$key") < before )) && return 0
  done
  return 1
}

domains=("$@")
for f in "$dir"/*.plist(N); do domains+=("${f:t:r}"); done

typeset -A seen
for d in $domains; do
  [[ -n $d ]] && (( ! ${+seen[$d]} )) || continue
  seen[$d]=1
  file=$dir/$d.plist

  # Converted to XML: defaults export writes a binary plist, an opaque blob in
  # a diff.
  if ! { defaults export "$d" "$file" 2>/dev/null \
         && plutil -convert xml1 "$file" 2>/dev/null \
         && grep -q '<key>' "$file" }; then
    rm -f -- "$file"
    print -u2 "no settings readable: $d"
    continue
  fi

  stripped=()
  for k in ${(f)"$(cred_keys "$file")"}; do
    [[ -n $k ]] || continue
    strip_key "$file" "$k" && stripped+=("$k")
  done
  noise=0
  for k in ${(f)"$(noise_keys "$file")"}; do
    [[ -n $k ]] || continue
    strip_key "$file" "$k" && (( noise++ ))
  done

  # The last word goes to gitleaks, not to the patterns above. Sketch keeps two
  # JWTs inside remote-asset-libraries, a name no credential pattern would ever
  # match, so guessing from key names is a first pass and this is the gate.
  if ! (( $+commands[gitleaks] )); then
    rm -f -- "$file"
    print -u2 "refused  $d: gitleaks is missing, run ./setup packages"
  elif ! gitleaks dir "$file" --no-banner --redact --log-level error >/dev/null 2>&1; then
    rm -f -- "$file"
    print -u2 "refused  $d: gitleaks found a secret in the export"
  else
    report="saved    $d"
    (( $#stripped )) && report+=", without ${(j:, :)stripped}"
    (( noise )) && report+=" ($noise noise key$( (( noise > 1 )) && print -n s) dropped)"
    print -r -- "$report"
  fi
done
