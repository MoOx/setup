#!/usr/bin/env zsh
# Refuse a commit that carries a secret. Installed through core.hooksPath, so
# the hook is versioned instead of living in .git/hooks.
#
# To commit anyway, when a finding is a checked false positive:
#   git commit --no-verify

emulate -L zsh
set -uo pipefail

if ! (( $+commands[gitleaks] )); then
  print -u2 "pre-commit: gitleaks is missing, run ./setup brew"
  exit 1
fi

# --pre-commit reads `git diff`, --staged restricts it to the index. --staged
# alone scans nothing and looks clean. Run twice: quiet, then verbose to show
# the findings, which are logged at info level.
if gitleaks git --pre-commit --staged --no-banner --redact --log-level warn 2>/dev/null; then
  exit 0
fi

gitleaks git --pre-commit --staged --no-banner --redact --verbose >&2

print -u2 ""
print -u2 "pre-commit: gitleaks found a secret in what you are about to commit."
print -u2 "Values are redacted above. Nothing has been committed."
print -u2 "If it is a false positive: git commit --no-verify"
exit 1
