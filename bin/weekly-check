#!/usr/bin/env zsh
# What the Monday agent runs. Reports, never applies.
#
# It notifies only when `setup --check` finds something, so a quiet week is
# silent. The notification names what drifted, with numbers, and clicking it
# opens the repository. The log holds the detail.

emulate -L zsh
set -uo pipefail

REPO=${0:A:h:h}

cd "$REPO" || exit 1

print "=== $(date '+%Y-%m-%d %H:%M') ==="

# Once, not twice. --check walks ~/dev and reads the usage date of every
# application, so running it again just to extract a summary doubled a job that
# already takes a while.
output=$(./setup --check 2>&1)
# `status` is read-only in zsh, a synonym for $?, so the result needs its own name.
rc=$?

print -r -- "$output"

if (( rc == 0 )); then
  print "nothing to report"
  exit 0
fi

# One line, because a notification is not a report: the log holds the detail.
# paste -d takes a list of delimiters and cycles through them, so '; ' joined
# the first pair with ';' and the next with a space. One delimiter, then the
# space.
summary=$(print -r -- "$output" | grep '  TODO' | sed 's/^ *TODO  //' \
  | paste -sd';' - | sed 's/;/; /g' | cut -c1-180)
[[ -n $summary ]] || summary="setup --check found something"

# Setup.app posts it, not osascript. Clicking a notification activates the
# application that posted it, so a notification from osascript belongs to
# Script Editor and the click leads nowhere, while this one opens the
# repository in Terminal. The app reads the summary from the flag file and
# removes it, which is also how it tells a fresh click apart from this launch.
#
# terminal-notifier did the clicking before and was dropped: Homebrew builds it
# as fr.julienxx.oss.terminal-notifier, the same bundle identifier as the copy
# inside a Ruby gem, and macOS is set to hide the notifications of that
# identity, so it waited five minutes for a delivery that never came. launchd
# starts no second instance of a job still running, so the next Monday would
# have been skipped.
notify=$HOME/.setup-notify   # same path as NOTIFY in setup
app=$HOME/Applications/Setup.app

if [[ -d $app ]]; then
  print -rn -- "$summary" >| "$notify"
  open -a "$app"
else
  # No app yet. Still say it, since a missed week is worse than a dead click.
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "Setup"' \
    -e 'end run' \
    "$summary" 2>/dev/null
  print "Setup.app is missing, the notification is not clickable: run ./setup agent"
fi

print "notified: $summary"
exit 0
